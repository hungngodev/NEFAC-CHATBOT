# =============================================================================
# NEFAC FRONTEND CONFIGURATION
# =============================================================================

# --- LangGraph Connection ---
# The URL of the LangGraph Backend API (Local Default: 8123)
NEXT_PUBLIC_API_URL=http://localhost:2024

# The ID of the graph to interact with (default: agent)
NEXT_PUBLIC_ASSISTANT_ID=agent

# --- Server-Side Proxy Configuration ---
# Used by the Next.js API route to forward requests to the backend
# This avoids CORS issues and hides the API key if needed
LANGGRAPH_API_URL=http://localhost:2024

# --- LangSmith Tracing (Optional) ---
# Do NOT prefix with NEXT_PUBLIC_ (Server-side only)
LANGSMITH_API_KEY=
