# =============================================================================
# NEFAC CHATBOT CONFIGURATION TEMPLATE
# =============================================================================

# --- Core API Keys ---
OPENAI_API_KEY=key-your-openai-api-key-here
TAVILY_API_KEY=tvly-your-tavily-key-here
GOOGLE_API_KEY=your-google-api-key-here

# --- Frontend Configuration ---
# URL of the LangGraph Backend API
NEXT_PUBLIC_API_URL=http://localhost:8123
# The ID of the graph to interact with (default: agent)
NEXT_PUBLIC_ASSISTANT_ID=agent
# (Optional) For server-side API proxy
LANGGRAPH_API_URL=http://localhost:8123

# --- LangSmith Tracing ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=nefac-chatbot
# Enable verbose debug logs for LangGraph
ENABLE_LANGGRAPH_DEBUG_LOGS=false

# --- Backend Graph Settings ---
# Max recursion depth for agent loops
GRAPH_RECURSION_LIMIT=60
# Rate limiting for graph ingestion
GRAPH_RATE_LIMIT_RETRIES=4
GRAPH_RATE_LIMIT_BACKOFF=5.0

# --- Database Configuration (Docker Defaults) ---

# Neo4j (Graph Database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
GRAPH_LI_ENABLE=true

# Elasticsearch (Keyword Search)
ES_HOST=http://localhost:9200
ES_INDEX=nefac-bm25
ES_LI_ENABLE=true
ELASTICSEARCH_STRATEGY=bm25

# Qdrant (Vector Store)
QDRANT_ENABLE=true
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_GRPC_ENDPOINT=http://localhost:6334
QDRANT_CLUSTER_ID=nefac_documents
QDRANT_ENABLE_HYBRID=true
# (Optional) API Key if using Qdrant Cloud
QDRANT_API_KEY=

# --- Crawler Configuration ---

# General
OUTPUT_DIR=nefac_documents
DOWNLOAD_FILES=true
MAX_WORKERS=10

# WordPress
WORDPRESS_URL=https://nefac.org
# (Optional) Basic Auth for WordPress
WORDPRESS_USERNAME=
WORDPRESS_PASSWORD=

# YouTube
YOUTUBE_ENABLED=true
YOUTUBE_API_KEY=your-youtube-api-key-here
YOUTUBE_CHANNEL=https://www.youtube.com/@nefac
# (Optional) Cookies file for yt-dlp to avoid rate limits
YOUTUBE_COOKIES_FILE=cookies.txt

# Proxies (Optional)
WEBSHARE_USERNAME=
WEBSHARE_PASSWORD=

# Other Auth (Optional)
FAUST_USERNAME=
FAUST_PASSWORD=
