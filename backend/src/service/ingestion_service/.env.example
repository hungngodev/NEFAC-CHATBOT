# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector Database (Optional - for vector search)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=us-west-2  # or your Pinecone environment

# Hugging Face (Optional - for local LLM contextualization)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Contextual retrieval (https://developers.llamaindex.ai/python/examples/cookbooks/contextual_retrieval/)
ENABLE_CONTEXTUAL_RETRIEVAL=true
ENABLE_METADATA_EXTRACTION=false
INGESTION_LLM_MODEL=gpt-4o-mini
INGESTION_LLM_TIMEOUT=60
INGESTION_LLM_MAX_RETRIES=3
ENABLE_YOUTUBE_TRANSCRIPTS=false

# Cohere reranker (optional for hybrid retrieval improvements)
COHERE_API_KEY=
HYBRID_RERANK_MODEL=rerank-english-v3.0

# Hybrid retrieval weights (https://developers.llamaindex.ai/python/examples/retrievers/multi_doc_together_hybrid/)
HYBRID_FUSION_STRATEGY=rrf
HYBRID_DENSE_WEIGHT=1.0
HYBRID_SPARSE_WEIGHT=0.75
HYBRID_GRAPH_WEIGHT=0.5
HYBRID_RRF_K=60.0
HYBRID_MIN_SCORE=0.0

# Elasticsearch (BM25 baseline, optional LlamaIndex vector)
ES_HOST=http://localhost:9200
ES_INDEX=nefac
ES_LI_ENABLE=false

# Neo4j (Optional - for graph database)
NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME is preferred, NEO4J_USER remains supported for backward compatibility
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password

# Qdrant (Vector DB)
QDRANT_ENABLE=true
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_CLUSTER_ID=nefac
# QDRANT_API_KEY=your_api_key_if_hosted
QDRANT_ENABLE_HYBRID=false
QDRANT_SPARSE_MODEL=Qdrant/bm25
# Note: Hybrid search uses FastEmbed under the hood when enabled.

# LlamaIndex Graph configuration (https://developers.llamaindex.ai/python/examples/property_graph/property_graph_neo4j/)
GRAPH_LI_ENABLE=false
# GRAPH_MODE options: property, raw, off
GRAPH_MODE=property
GRAPH_LLM_MODEL=gpt-4o
GRAPH_LLM_TIMEOUT=150
GRAPH_LLM_MAX_RETRIES=2

# Diagnostics
INGESTION_FAIL_ON_MISSING=false

# Semantic splitter (LlamaIndex node parser)
SEMANTIC_SPLITTER_SPACY_MODEL=en_core_web_sm
SEMANTIC_SPLITTER_INITIAL_THRESHOLD=0.4
SEMANTIC_SPLITTER_APPEND_THRESHOLD=0.5
SEMANTIC_SPLITTER_MERGE_THRESHOLD=0.5
SEMANTIC_SPLITTER_MAX_CHUNK=2000

# Logging
LOG_LEVEL=INFO 
