# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Pinecone Vector Database (Optional - for vector search)
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_ENV=us-west-2  # or your Pinecone environment

# Hugging Face (Optional - for local LLM contextualization)
HUGGINGFACE_API_KEY=your_huggingface_token_here

# Elasticsearch (BM25 baseline, optional LlamaIndex vector)
ES_HOST=http://localhost:9200
ES_INDEX=nefac
ES_LI_ENABLE=false

# Neo4j (Optional - for graph database)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# Qdrant (Vector DB)
QDRANT_ENDPOINT=http://localhost:6333
QDRANT_CLUSTER_ID=nefac
# QDRANT_API_KEY=your_api_key_if_hosted
QDRANT_ENABLE_HYBRID=false
QDRANT_SPARSE_MODEL=Qdrant/bm25
# Note: Hybrid search uses FastEmbed under the hood when enabled.

# LlamaIndex Graph toggle
GRAPH_LI_ENABLE=false
GRAPH_LI_USE_PROPERTY_GRAPH=false
GRAPH_LI_MODEL=gpt-4o-mini

# Semantic splitter (LlamaIndex node parser)
SEMANTIC_SPLITTER_SPACY_MODEL=en_core_web_sm
SEMANTIC_SPLITTER_INITIAL_THRESHOLD=0.4
SEMANTIC_SPLITTER_APPEND_THRESHOLD=0.5
SEMANTIC_SPLITTER_MERGE_THRESHOLD=0.5
SEMANTIC_SPLITTER_MAX_CHUNK=2000

# Logging
LOG_LEVEL=INFO 

# LlamaParse (optional PDF parsing)
LLAMAPARSE_ENABLE=false
# LLAMAPARSE_API_KEY=your_llamaparse_api_key