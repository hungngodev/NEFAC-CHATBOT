# NEFAC Document Crawler Migration Configuration
# Copy this file to .env and add your actual values
# WordPress Content Extraction: Posts, Pages, News, Media + YouTube

# =============================================================================
# WORDPRESS AUTHENTICATION
# =============================================================================

# WordPress Application Password authentication (recommended)
WORDPRESS_USERNAME=your_wordpress_username_here
WORDPRESS_PASSWORD=your_wordpress_app_password_here

# Legacy Faust authentication (deprecated)
FAUST_USERNAME=your_faust_username_here
FAUST_PASSWORD=your_faust_password_here
FAUST_SECRET_KEY=your_faust_secret_key_here

# =============================================================================
# CORE SETTINGS
# =============================================================================

# Output directory for downloaded files
OUTPUT_DIR=nefac_documents

# WordPress base URL
WORDPRESS_BASE_URL=https://nefac.org

# Whether to download files (true/false)
DOWNLOAD_FILES=true

# =============================================================================
# MIGRATION FEATURES
# =============================================================================

# Enable document deduplication
ENABLE_DEDUPLICATION=true

# Enable metadata merging from multiple sources
ENABLE_METADATA_MERGING=true

# =============================================================================
# EXTERNAL CRAWLING
# =============================================================================

# Comma-separated list of allowed external domains
EXTERNAL_DOMAIN_WHITELIST=supremecourt.gov,congress.gov,law.cornell.edu,justia.com,courtlistener.com,govinfo.gov,regulations.gov

# Maximum crawl depth for external links
MAX_EXTERNAL_DEPTH=2

# Maximum number of external URLs to crawl
EXTERNAL_CRAWL_LIMIT=100

# =============================================================================
# DEDUPLICATION SETTINGS
# =============================================================================

# Content similarity threshold for exact duplicates (0.0-1.0)
CONTENT_SIMILARITY_THRESHOLD=0.95

# Enable content hashing for duplicate detection
ENABLE_CONTENT_HASHING=true

# =============================================================================
# METADATA MERGING & SOURCE PRIORITIES
# =============================================================================

# Source priority scores (higher = more authoritative)
WORDPRESS_PRIORITY=80
YOUTUBE_PRIORITY=70
WEB_SCRAPER_PRIORITY=30
LINK_DISCOVERY_PRIORITY=20

# =============================================================================
# YOUTUBE CONFIGURATION
# =============================================================================

# YouTube API key for accessing YouTube Data API
YOUTUBE_API_KEY=your_youtube_api_key_here

# Basic YouTube settings
YOUTUBE_ENABLED=true
YOUTUBE_CHANNEL_URL=https://www.youtube.com/@nefac
YOUTUBE_MAX_VIDEOS=1000
YOUTUBE_ENABLE_TRANSCRIPTS=true
YOUTUBE_ENABLE_METADATA=true

# Rate limiting (YouTube is strict about this)
YOUTUBE_REQUEST_DELAY=10.0
YOUTUBE_MAX_CONCURRENT=1
YOUTUBE_BATCH_SIZE=1
YOUTUBE_RETRY_DELAY=30.0
YOUTUBE_MAX_RETRIES=3
YOUTUBE_TIMEOUT=120

# API and proxy settings
YOUTUBE_USE_PROXY=false
# YOUTUBE_WEBSHARE_USERNAME=your_webshare_username
# YOUTUBE_WEBSHARE_PASSWORD=your_webshare_password

# Content filtering
YOUTUBE_MIN_DURATION=30
YOUTUBE_MAX_DURATION=14400
YOUTUBE_SKIP_LIVE=true
YOUTUBE_SKIP_SHORTS=false

# Quality settings
YOUTUBE_TRANSCRIPT_LANG=en
YOUTUBE_EXTRACT_CHAPTERS=true
YOUTUBE_EXTRACT_COMMENTS=false

# Output organization
YOUTUBE_OUTPUT_SUBDIR=youtube
YOUTUBE_SAVE_THUMBNAILS=true
YOUTUBE_SAVE_METADATA=true

# Error handling
YOUTUBE_CONTINUE_ON_ERROR=true
YOUTUBE_LOG_FAILED=true

# =============================================================================
# PROXY CREDENTIALS
# =============================================================================

# Webshare.io Residential Proxy Credentials (for YouTube crawling)
# See: https://www.webshare.io/
WEBSHARE_USERNAME=your_webshare_username
WEBSHARE_PASSWORD=your_webshare_password

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================

# Request delay between requests (seconds)
REQUEST_DELAY=0.5

# Maximum worker threads
MAX_WORKERS=10

# Maximum concurrent requests
MAX_CONCURRENT_REQUESTS=10

# Batch size for processing
BATCH_SIZE=50

# Enable caching
ENABLE_CACHING=true

# Request timeout in seconds
REQUEST_TIMEOUT=30

# Download timeout in seconds
DOWNLOAD_TIMEOUT=60

# =============================================================================
# RETRY SETTINGS
# =============================================================================

# Maximum retry attempts
MAX_RETRIES=3

# =============================================================================
# CONTENT FILTERING
# =============================================================================

# Minimum content length (characters)
MIN_CONTENT_LENGTH=100

# Maximum file size (bytes) - 100MB default
MAX_FILE_SIZE=104857600

# =============================================================================
# LOGGING AND MONITORING
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable detailed statistics
ENABLE_STATISTICS=true

# Enable progress tracking
ENABLE_PROGRESS_TRACKING=true

# Statistics reporting interval
STATISTICS_INTERVAL=100
