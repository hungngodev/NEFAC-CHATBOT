{
  "dependencies": ["."],
  "graphs": {
    "agent": {
      "path": "src.app.server:deep_researcher",
      "config_schema": "src.config.settings:Configuration"
    }
  },
  "image_distro": "wolfi",
  "env": "../.env",
  "http": {
    "cors": {
      "allow_origins": ["http://localhost:3000"],
      "allow_methods": ["*"],
      "allow_headers": ["*"]
    }
  },
  "dockerfile_lines": [
    "RUN apk add --no-cache build-base pkgconf openblas-dev"
  ],
  "checkpointer": {
    "ttl": {
      "strategy": "delete",
      "sweep_interval_minutes": 10080,
      "default_ttl": 43200
    }
  }
}
